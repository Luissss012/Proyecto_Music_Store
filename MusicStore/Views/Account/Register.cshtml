@model MusicStore.Models.RegisterModel
@{ ViewBag.Title = "Crear cuenta"; }
<h1>Crear cuenta</h1>
<p>Usa al menos 10 caracteres, mayúscula, minúscula, número y símbolo.</p>
@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "col-md-6" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="mb-3">@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.Password) @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", maxlength = "128" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.ConfirmPassword) @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", maxlength = "128" })</div>
    <button class="btn btn-primary" type="submit">Registrarme</button>
}
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
