@model MusicStore.Models.LoginModel
@{ ViewBag.Title = "Iniciar sesión"; }
<h1>Iniciar sesión</h1>
@if (TempData["AccountMessage"] != null) { <div class="alert alert-success">@TempData["AccountMessage"]</div> }
@using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "col-md-6" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="mb-3">@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.Password) @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password", maxlength = "128" })</div>
    <button class="btn btn-primary" type="submit">Entrar</button>
    @Html.ActionLink("Crear cuenta", "Register", new { returnUrl = ViewBag.ReturnUrl }, new { @class = "btn btn-link" })
}
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
