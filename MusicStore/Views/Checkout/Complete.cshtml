@model MusicStore.Models.Order
@using System.Globalization
@{ ViewBag.Title = "Orden " + Model.OrderId; }
<h1>Orden #@Model.OrderId confirmada</h1>
<div class="alert alert-success" role="status">Tu orden de demostración está guardada. No se realizó ningún cobro.</div>
<p>Fecha UTC: @Model.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Álbum</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead><tbody>
@foreach (var item in Model.OrderDetails.OrderBy(i => i.OrderDetailId))
{ <tr><td>@item.AlbumTitle <span class="text-secondary">· @item.ArtistName</span></td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture)</td><td>@((item.Quantity * item.UnitPrice).ToString("0.00", CultureInfo.InvariantCulture))</td></tr> }
</tbody></table></div>
<p class="h4">Total: @Model.Total.ToString("0.00", CultureInfo.InvariantCulture)</p>
<section class="music-store-card mt-3"><h2 class="h4">Datos registrados</h2><p>@Model.FirstName @Model.LastName</p><p>@Model.Address · @Model.City · @Model.State · @Model.PostalCode · @Model.Country</p><p>@Model.Email · @Model.Phone</p></section>
<p>@Html.ActionLink("Mis pedidos", "Orders", null, new { @class = "btn btn-primary" }) @Html.ActionLink("Seguir comprando", "Index", "Store", null, new { @class = "btn btn-outline-primary" })</p>
