@model MusicStore.Models.CheckoutForm
@{ ViewBag.Title = "Confirmar compra"; }
<h1>Confirmar compra</h1>
<div class="alert alert-info">Compra de demostración: usa el código <strong>FREE</strong>. No se realiza ningún cobro ni se solicitan tarjetas.</div>
@Html.Partial("_Summary", Model.Cart)
@if (Model.Cart.Items.Count > 0)
{
    using (Html.BeginForm("AddressAndPayment", "Checkout", FormMethod.Post, new { @class = "col-lg-8", id = "checkout-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger", role = "alert" })
        <input type="hidden" name="Ticket" value="@Model.Ticket" />
        <fieldset>
            <legend>Datos de la orden</legend>
            <div class="row">
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.FirstName) @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", maxlength = "80", autocomplete = "given-name" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.LastName) @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", maxlength = "80", autocomplete = "family-name" })</div>
                <div class="col-12 mb-3">@Html.LabelFor(m => m.Address) @Html.TextBoxFor(m => m.Address, new { @class = "form-control", maxlength = "200", autocomplete = "street-address" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.City) @Html.TextBoxFor(m => m.City, new { @class = "form-control", maxlength = "80", autocomplete = "address-level2" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.State) @Html.TextBoxFor(m => m.State, new { @class = "form-control", maxlength = "80", autocomplete = "address-level1" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.PostalCode) @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control", maxlength = "20", autocomplete = "postal-code" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.Country) @Html.TextBoxFor(m => m.Country, new { @class = "form-control", maxlength = "80", autocomplete = "country-name" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.Phone) @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", maxlength = "30", type = "tel", autocomplete = "tel" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email, new { @class = "form-control", maxlength = "254", type = "email", autocomplete = "email" })</div>
                <div class="col-sm-6 mb-3">@Html.LabelFor(m => m.PromoCode) @Html.TextBoxFor(m => m.PromoCode, new { @class = "form-control", maxlength = "20", autocomplete = "off", aria_describedby = "promo-help" })<small id="promo-help">Código para la demo: FREE</small></div>
            </div>
        </fieldset>
        <button class="btn btn-primary" type="submit">Confirmar orden de demostración</button>
        @Html.ActionLink("Volver al carrito", "Index", "ShoppingCart", null, new { @class = "btn btn-link" })
    }
}
else
{
    @Html.ValidationSummary(false, "", new { @class = "text-danger", role = "alert" })
    <p>El carrito está vacío.</p>
    @Html.ActionLink("Volver al carrito", "Index", "ShoppingCart", null, new { @class = "btn btn-primary" })
}
@section scripts { @Scripts.Render("~/bundles/jqueryval", "~/bundles/checkout") }
