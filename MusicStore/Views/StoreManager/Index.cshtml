@model IEnumerable<MusicStore.Models.Album>

@{
    ViewBag.Title = "Administrar álbumes";
}

<h2>Administrar álbumes</h2>

<p>
    @Html.ActionLink("Crear nuevo álbum", "Create")
</p>

<table class="table">
    <tr>
        <th>Artista</th>
        <th>Género</th>
        <th>Título</th>
        <th>Precio</th>
        <th>URL de portada</th>
        <th>Acciones</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Artist.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AlbumArtUrl)
            </td>
            <td>
                @Html.ActionLink("Editar", "Edit", new { id = item.AlbumId }) |
                @Html.ActionLink("Detalles", "Details", new { id = item.AlbumId }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.AlbumId })
            </td>
        </tr>
    }
</table>