@model MusicStore.Models.Album

@{
    ViewBag.Title = "Detalle del álbum";
}

<div class="music-store-card">

    <h2>Detalle del álbum</h2>

    <hr />

    <p>
        <strong>Título:</strong>
        @Model.Title
    </p>

    <p>
        <strong>Género:</strong>
        @Model.Genre.Name
    </p>
    <p><strong>Artista:</strong> @Model.Artist.Name</p>
    <p><strong>Precio:</strong> @Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p>
    @using (Html.BeginForm("AddToCart", "ShoppingCart", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="albumId" value="@Model.AlbumId" />
        <button type="submit" class="btn btn-primary">Agregar al carrito</button>
    }

</div>

<p>
    @Html.ActionLink(
            "← Volver a " + Model.Genre.Name,
            "Browse",
            new { genre = Model.Genre.Name },
            new { @class = "btn btn-outline-dark" }
        )

    @Html.ActionLink(
            "Volver a la tienda",
            "Index",
            null,
            new { @class = "btn btn-dark" }
        )
</p>
