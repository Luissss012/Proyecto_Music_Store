@model MusicStore.Models.Album
@{ ViewBag.Title = Model.Title; }
<p class="eyebrow"><a href="@Url.Action("Index")">COLECCIÓN</a> / <a href="@Url.Action("Browse", new { genre = Model.Genre.Name })">@Model.Genre.Name</a></p>
<div class="album-detail">
<div>@Html.Partial("_Albums", new[] { Model })</div>
<section><p class="eyebrow">TU PRÓXIMA ESCUCHA</p><h1>@Model.Title</h1><p class="detail-artist">@Model.Artist.Name</p><p>Género: @Model.Genre.Name</p><p class="detail-price">@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p><p>Álbum de la colección Music Store. Agrégalo a tu carrito y continúa explorando.</p>
@using (Html.BeginForm("AddToCart", "ShoppingCart", FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="albumId" value="@Model.AlbumId" /><button type="submit" class="btn btn-primary btn-lg">Agregar al carrito +</button> }
<p class="mt-3 text-secondary">Compra de demostración · Sin cobro real</p><a href="@Url.Action("Browse", new { genre = Model.Genre.Name })">← Más de @Model.Genre.Name</a></section></div>
