@model MusicStore.Models.Genre
@{ ViewBag.Title = Model.Name; }
<header class="page-heading"><p class="eyebrow"><a href="@Url.Action("Index")">LA COLECCIÓN</a> / @Model.Name</p><h1>@Model.Name<span class="accent">.</span></h1><p>Encuentra nuevos favoritos y redescubre el sonido que te gusta.</p></header>
@if (!Model.Albums.Any()) { <p class="music-store-card">Este género todavía no tiene álbumes. Explora los demás géneros de la colección.</p> }
@Html.Partial("_Albums", Model.Albums.OrderBy(a => a.Title))
<p class="mt-4"><a class="btn btn-outline-dark" href="@Url.Action("Index")">← Todos los géneros</a></p>
