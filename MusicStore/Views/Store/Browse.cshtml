@model MusicStore.Models.Genre

@{
    ViewBag.Title = "Explorar género";
}

<div class="music-store-card">
    <h2>@Model.Name</h2>

    <p>
        Explora los álbumes disponibles dentro del género
        <strong>@Model.Name</strong>.
    </p>
</div>

<ul class="music-store-list">
    @foreach (var album in Model.Albums)
    {
        <li>
            @Html.ActionLink(
                     album.Title,
                     "Details",
                     new { id = album.AlbumId },
                     null
                 )
        </li>
    }
</ul>

<p>
    @Html.ActionLink(
            "← Volver a géneros",
            "Index",
            null,
            new { @class = "btn btn-outline-dark" }
        )
</p>