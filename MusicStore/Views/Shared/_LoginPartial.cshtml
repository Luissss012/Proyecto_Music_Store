@if (Request.IsAuthenticated)
{
    <div class="navbar-nav flex-lg-row align-items-lg-center gap-2 account-navigation">
        @if (User.IsInRole("Administrator")) { @Html.ActionLink("Administración", "Index", "Admin", null, new { @class = "nav-link" }) }
        <span class="navbar-text account-name" title="@User.Identity.Name">Hola, @User.Identity.Name</span>
        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
        }
    </div>
}
else
{
    <div class="navbar-nav">
        @Html.ActionLink("Crear cuenta", "Register", "Account", null, new { @class = "nav-link" })
        @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "nav-link" })
    </div>
}
