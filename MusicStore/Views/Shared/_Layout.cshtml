<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f5f2eb" /><title>@ViewBag.Title - Music Store</title>@Styles.Render("~/Content/css")@Scripts.Render("~/bundles/modernizr")</head>
<body><a class="skip-link" href="#main-content">Saltar al contenido</a><div class="announcement">MÚSICA PARA CADA MOMENTO <span>·</span> TIENDA DE DEMOSTRACIÓN / SIN COBROS REALES</div>
<nav class="navbar navbar-expand-lg navbar-light store-nav" aria-label="Navegación principal"><div class="container"><a class="navbar-brand" href="@Url.Action("Index", "Home")">music<span>store</span><sup>®</sup></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir navegación"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="main-navigation"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Inicio</a></li><li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Store")">Colección</a></li></ul>@{ Html.RenderAction("CartSummary", "Navigation"); }@Html.Partial("_LoginPartial")</div></div></nav>
<div class="container">@{ Html.RenderAction("Genres", "Navigation"); }</div><main id="main-content" class="container body-content" tabindex="-1">@RenderBody()</main>
<footer class="store-footer"><div class="container"><div><strong>musicstore®</strong><p>Un nuevo disco. Un nuevo momento.</p></div><div><a href="@Url.Action("Index", "Store")">Explorar colección ↗</a><p>Proyecto académico · @DateTime.Now.Year<br />Pedidos de demostración con el código FREE.</p></div></div></footer>
@Scripts.Render("~/bundles/jquery", "~/bundles/bootstrap", "~/bundles/store")@RenderSection("scripts", required: false)</body></html>
