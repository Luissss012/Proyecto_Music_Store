<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Music Store</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            @Html.ActionLink(
                     "Music Store",
                     "Index",
                     "Store",
                     new { area = "" },
                     new { @class = "navbar-brand" }
                 )

            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    title="Alternar navegación"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-lg-flex flex-wrap justify-content-between gap-2">

                <ul class="navbar-nav flex-grow-1">

                    <li class="nav-item">
                        @Html.ActionLink(
                                 "Inicio",
                                 "Index",
                                 "Home",
                                 null,
                                 new { @class = "nav-link" }
                             )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                                 "Tienda",
                                 "Index",
                                 "Store",
                                 null,
                                 new { @class = "nav-link" }
                             )
                    </li>

                </ul>
                @Html.ActionLink("Carrito", "Index", "ShoppingCart", null, new { @class = "nav-link text-light" })
                @Html.Partial("_LoginPartial")

            </div>

        </div>
    </nav>

    <div class="container body-content mt-4">

        @RenderBody()

        <hr />

        <footer class="text-center">
            <p>
                &copy; @DateTime.Now.Year - ASP.NET MVC Music Store
            </p>
        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
