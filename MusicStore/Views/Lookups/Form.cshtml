@model MusicStore.Models.LookupForm
@{ ViewBag.Title = (Model.Id == 0 ? "Crear" : "Editar") + " · " + ViewBag.Label; }
<h1>@ViewBag.Title</h1>
@using (Html.BeginForm(Model.Id == 0 ? "Create" : "Edit", (string)ViewContext.RouteData.Values["controller"], new { id = Model.Id == 0 ? (int?)null : Model.Id }, FormMethod.Post, new { @class = "col-md-7" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Version)
    @Html.ValidationSummary(false, "", new { @class = "text-danger", role = "alert" })
    <div class="mb-3">@Html.LabelFor(m => m.Name) @Html.TextBoxFor(m => m.Name, new { @class = "form-control", maxlength = "160" })</div>
    if (ViewBag.IsGenre) { <div class="mb-3">@Html.LabelFor(m => m.Description) @Html.TextAreaFor(m => m.Description, new { @class = "form-control", maxlength = "1000", rows = "4" })</div> }
    <button class="btn btn-primary" type="submit">Guardar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-link" })
}
<p class="mt-3">Después de guardar, vuelve al formulario del álbum o recárgalo para ver el nuevo registro en la lista.</p>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
